NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=wallet_user
DB_PASSWORD=wallet_password
DB_NAME=wallet_db

# JWT
JWT_SECRET=change-me-use-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m

# Wallet tokens — omit or leave empty for no expiry
# WALLET_TOKEN_TTL_DAYS=90

# Rate limiting (global defaults)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
